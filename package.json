    "lucide": "^1.52.0",
    "nodemailer": "^10.0.15",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  }
