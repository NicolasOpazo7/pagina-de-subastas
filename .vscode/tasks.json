{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Aurum Subastas",
      "type": "shell",
      "command": "npm start",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Aurum Subastas listo",
          "endsPattern": "Aurum Subastas listo"
        }
      }
    }
  ]
}
