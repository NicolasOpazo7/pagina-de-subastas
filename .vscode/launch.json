{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Aurum local (SQLite)",
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": ["--experimental-sqlite"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Aurum demostracion",
      "program": "${workspaceFolder}/backend/demo.js",
      "runtimeArgs": ["--experimental-sqlite"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
